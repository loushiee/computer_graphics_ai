float upDownFactor()
{
    float pause = 5.0;
    float transition = 1.0;
    float cycle = 2. * (pause + transition);
    float t = mod(iTime, cycle);

    // pause at 0
    if (t < pause)
        return 0.0;

    t -= pause;

    // rise 0 → 1
    if (t < transition)
        return t / transition;

    t -= transition;

    // pause at 1
    if (t < pause)
        return 1.0;

    t -= pause;

    // fall 1 → 0
    return 1.0 - (t / transition);}

float rampFactor()
{
    float duration = 18.;
    float segment = floor(iTime / duration);
    float local = mod(iTime, duration) / duration;
    return segment + local;
}

vec3 rotateHand(vec3 p)
{
    p = rotate(p, vec3(0., 0., 1.), PI);
    p = rotate(p, vec3(0., 1., 0.), 2. * PI * rampFactor());
    return p;
}

