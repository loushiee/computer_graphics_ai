float sdfUnion(float d1, float d2)
{
    return min(d1, d2);
}

/////////////////////////////////////////////////////
//// Step 3: scene sdf
//// You are asked to use the sdf boolean operations to draw the bunny and the cow in the scene.
//// The bunny is located in the ceter of vec3(-1.0, 1., 4.), and the cow is located in the center of vec3(1.0, 1., 4.).
/////////////////////////////////////////////////////

//// sdf: p - query point
float sdf(vec3 p)
{
    float s = 0.;

    float plane_h = -0.1;

    //// calculate the sdf based on all objects in the scene

    //// your implementation starts
    float dPlane = sdfPlane(p, plane_h);
    float dCow = sdfCow(p - vec3(1.0, 1., 4.));
    float dBunny = sdfBunny(p - vec3(-1.0, 1., 4.));
    s = sdfUnion(dPlane, sdfUnion(dCow, dBunny));
    //// your implementation ends

    return s;
}

float sdf_creative(vec3 p)
{
    vec3 pos = vec3(0., 1., 4.);
    float d1 = sdfHandOpen(p - pos);
    float d2 = sdfHandClose(p - pos);
    float dMorph = mix(d1, d2, upDownFactor());
    float plane_h = -0.1;
    float dPlane = sdfPlane(p, plane_h);
    return sdfUnion(dPlane, dMorph);
}

