//// ray marching
/////////////////////////////////////////////////////

/////////////////////////////////////////////////////
//// Step 4: ray marching
//// You are asked to implement the ray marching algorithm within the following for-loop.
//// You are allowed to reuse your previous implementation in A2a for this function.
/////////////////////////////////////////////////////

//// ray marching: origin - ray origin; dir - ray direction 
float rayMarching(vec3 origin, vec3 dir)
{
    float s = 0.0;

    //// your implementation starts
    for (int i = 0; i < 100; i++)
    {
        vec3 originCurrent = origin + (s * dir);
        float sCurrent = sdf(originCurrent);
        if (sCurrent < 0.000001) {
            break;
        }
        s += sCurrent;
    }
    //// your implementation ends

    return s;
}

float rayMarching_creative(vec3 origin, vec3 dir)
{
    float s = 0.0;

    //// your implementation starts
    for (int i = 0; i < 100; i++)
    {
        vec3 originCurrent = origin + (s * dir);
        float sCurrent = sdf_creative(originCurrent);
        if (sCurrent < 0.000001) {
            break;
        }
        s += sCurrent;
    }
    //// your implementation ends

    return s;
}

