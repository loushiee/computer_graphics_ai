//// normal calculation
/////////////////////////////////////////////////////

/////////////////////////////////////////////////////
//// Step 5: normal calculation
//// You are asked to calculate the sdf normal based on finite difference.
//// You are allowed to reuse your previous implementation in A2a for this function.
/////////////////////////////////////////////////////

//// normal: p - query point
vec3 normal(vec3 p)
{
    float s = sdf(p);          //// sdf value in p
    float dx = 0.01;           //// step size for finite difference

    //// your implementation starts
    float gx = sdf(p + vec3(dx, 0.0, 0.0)) - sdf(p - vec3(dx, 0.0, 0.0));
    float gy = sdf(p + vec3(0.0, dx, 0.0)) - sdf(p - vec3(0.0, dx, 0.0));
    float gz = sdf(p + vec3(0.0, 0.0, dx)) - sdf(p - vec3(0.0, 0.0, dx));
    vec3 g = vec3(gx, gy, gz) / 2.0*dx;
    vec3 n = normalize(g);
    //// your implementation ends

    return n;
}

vec3 normal_creative(vec3 p)
{
    float s = sdf_creative(p);          //// sdf value in p
    float dx = 0.01;           //// step size for finite difference

    //// your implementation starts
    float gx = sdf_creative(p + vec3(dx, 0.0, 0.0)) - sdf_creative(p - vec3(dx, 0.0, 0.0));
    float gy = sdf_creative(p + vec3(0.0, dx, 0.0)) - sdf_creative(p - vec3(0.0, dx, 0.0));
    float gz = sdf_creative(p + vec3(0.0, 0.0, dx)) - sdf_creative(p - vec3(0.0, 0.0, dx));
    vec3 g = vec3(gx, gy, gz) / 2.0*dx;
    vec3 n = normalize(g);
    //// your implementation ends

    return n;
}

/////////////////////////////////////////////////////
//// Phong shading
/////////////////////////////////////////////////////

/////////////////////////////////////////////////////
//// Step 6: lighting and coloring
//// You are asked to specify the color for the two neural SDF objects in the scene.
//// Each object must have a separate color without mixing.
//// Notice that we have implemented the default Phong shading model for you.
/////////////////////////////////////////////////////

vec3 phong_shading(vec3 p, vec3 n)
{
    //// background
    if(p.z > 20.0)
    {
        vec3 color = vec3(0.04, 0.16, 0.33);
        return color;
    }

    //// phong shading
    vec3 lightPos = vec3(4. * sin(iTime), 4., 4. * cos(iTime));
    vec3 l = normalize(lightPos - p);
    float amb = 0.1;
    float dif = max(dot(n, l), 0.) * 0.7;
    vec3 eye = CAM_POS;
    float spec = pow(max(dot(reflect(-l, n), normalize(eye - p)), 0.0), 128.0) * 0.9;

    vec3 sunDir = normalize(vec3(0, 1, -1)); //// parallel light direction
    float sunDif = max(dot(n, sunDir), 0.) * 0.2;

    //// shadow
    float s = rayMarching(p + n * 0.02, l);
    if(s < length(lightPos - p))
        dif *= .2;

    vec3 color = vec3(1.0);

    //// your implementation starts
    float plane_h = -0.1;
    float dPlane = sdfPlane(p, plane_h);

    float dCow = sdfCow(p - vec3(1.0, 1., 4.));
    float dBunny = sdfBunny(p - vec3(-1.0, 1., 4.));
    float dSmallest = 1e9;
    color = vec3(8, 40, 82) / 255.0;

    if (dPlane < dSmallest) {
        dSmallest = dPlane;
        color = vec3(207, 207, 157) / 255.0;
    }
    if (dCow < dSmallest) {
        dSmallest = dCow;
        color = vec3(1, 239, 237) / 255.0;
    }
    if (dBunny < dSmallest) {
        dSmallest = dBunny;
        color = vec3(240, 113, 114) / 255.0;
    }
    //// your implementation ends

    return (amb + dif + spec + sunDif) * color;
}

vec3 phong_shading_creative(vec3 p, vec3 n)
{
    //// background
    if(p.z > 20.0)
    {
        vec3 color = vec3(0.04, 0.16, 0.33);
        return color;
    }

    //// phong shading
    vec3 lightPos = vec3(4. * sin(iTime), 4., 4. * cos(iTime));
    vec3 l = normalize(lightPos - p);
    float amb = 0.1;
    float dif = max(dot(n, l), 0.) * 0.7;
    vec3 eye = CAM_POS;
    float spec = pow(max(dot(reflect(-l, n), normalize(eye - p)), 0.0), 128.0) * 0.9;

    vec3 sunDir = normalize(vec3(0, 1, -1)); //// parallel light direction
    float sunDif = max(dot(n, sunDir), 0.) * 0.2;

    //// shadow
    float s = rayMarching_creative(p + n * 0.02, l);
    if(s < length(lightPos - p))
        dif *= .2;

    vec3 color = vec3(8, 40, 82) / 255.0;
    float plane_h = -0.1;
    float dPlane = sdfPlane(p, plane_h);
    float dMorph = sdf_creative(p);
    float dSmallest = 1e9;
    if (dPlane < dSmallest) {
        dSmallest = dPlane;
        color = vec3(31, 82, 77) / 255.0;
    }
    if (dMorph < dSmallest) {
        dSmallest = dMorph;
        color = vec3(198,134,66) / 255.0;
    }

    return (amb + dif + spec + sunDif) * color;
}

